#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    behaviors {
        td_numpad: tap_dance_numpad {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_NUMPAD";
            #binding-cells = <0>;
            tapping-term-ms = <200>;

            // 1 tap = momentané, 2 taps = permanent (toggle)

            bindings = <&mo LOWER>, <&tog LOWER>;
        };

        spc_bs: spc_bs {
            compatible = "zmk,behavior-hold-tap";
            label = "SPC_BS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "tap-unless-interrupted";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&mt PRINTSCREEN GRAVE  &kp N1  &kp N2    &kp N3    &kp N4     &kp N5                                             &kp N6     &kp N7     &kp N8     &kp N9    &kp N0    &mt EQUAL MINUS
&kp ESC                &kp Q   &kp W     &kp E     &kp R      &kp T                                              &kp Y      &kp U      &kp I      &kp O     &kp P     &mt RIGHT_BRACKET LEFT_BRACKET
&kp TAB                &kp A   &kp S     &kp D     &kp F      &kp G                                              &kp H      &kp J      &kp K      &kp L     &kp SEMI  &mt BACKSLASH SQT
&kp LSHFT              &kp Z   &kp X     &kp C     &kp V      &kp B       &kp C_MUTE    &rgb_ug RGB_TOG          &kp N      &kp M      &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                               &kp LGUI  &kp LALT  &kp LCTRL  &td_numpad  &kp RET       &spc_bs BACKSPACE SPACE  &mo RAISE  &kp RCTRL  &kp RALT   &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            bindings = <
&kp B              &kp F1     &kp F2     &kp F3    &kp F4    &kp F5                       &kp F6     &kp F7           &kp RS(KP_DIVIDE)  &kp KP_MULTIPLY  &kp KP_SUBTRACT   &mt LC(LA(DELETE)) PRINTSCREEN
&kp GRAVE          &kp N1     &kp N2     &kp N3    &kp N4    &kp N5                       &kp PSCRN  &kp KP_NUMBER_7  &kp KP_NUMBER_8    &kp KP_NUMBER_9  &kp KP_PLUS       &kp DELETE
&ext_power EP_TOG  &kp EXCL   &kp AT     &kp HASH  &kp DLLR  &kp PRCNT                    &kp TAB    &kp KP_NUMBER_4  &kp KP_NUMBER_5    &kp KP_NUMBER_6  &kp KP_ENTER      &kp PIPE
&trans             &kp EQUAL  &kp MINUS  &kp PLUS  &kp LBRC  &kp RBRC   &trans    &trans  &kp N0     &kp KP_NUMBER_1  &kp KP_NUMBER_2    &kp KP_NUMBER_3  &kp LS(KP_ENTER)  &trans
                              &trans     &trans    &trans    &trans     &trans    &trans  &trans     &kp KP_NUMBER_0  &kp KP_DOT         &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans     &trans    &trans    &trans     &trans   &trans
&trans      &kp INS       &kp PSCRN     &kp K_CMENU   &out OUT_BLE  &out OUT_USB                    &kp PG_UP  &trans    &kp UP    &trans     &kp N0   &trans
&trans      &kp LALT      &kp LCTRL     &kp LSHFT     &trans        &kp CLCK                        &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp DEL  &kp BSPC
&trans      &kp K_UNDO    &kp K_CUT     &kp K_COPY    &kp K_PASTE   &trans        &trans    &trans  &trans     &trans    &trans    &trans     &trans   &trans
                          &trans        &trans        &trans        &trans        &trans    &trans  &trans     &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            display-name = "adjust";
            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                     &none  &none  &none  &none  &none  &none
&ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF                  &none  &none  &none  &none  &none  &none
&none              &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &none            &none            &none                            &none  &none  &none  &none  &none  &none
&none              &none            &none            &none            &none            &none            &none    &none  &none  &none  &none  &none  &none  &none
                                    &none            &none            &none            &none            &none    &none  &none  &none  &none  &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // Cette couche n'est pas utilisée par le firmware mais sera dessinée

        lower_backup {
            status = "reserved"; // Indique à ZMK de l'ignorer mais garde le code
            bindings = <
&trans             &kp F1     &kp F2     &kp F3    &kp F4    &kp F5                       &kp F6     &kp F7    &kp F8     &kp F9     &kp F10   &kp F11
&kp GRAVE          &kp N1     &kp N2     &kp N3    &kp N4    &kp N5                       &kp N6     &kp N7    &kp N8     &kp N9     &kp N0    &kp F12
&ext_power EP_TOG  &kp EXCL   &kp AT     &kp HASH  &kp DLLR  &kp PRCNT                    &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR   &kp RPAR  &kp PIPE
&trans             &kp EQUAL  &kp MINUS  &kp PLUS  &kp LBRC  &kp RBRC   &trans    &trans  &kp LBKT   &kp RBKT  &kp SEMI   &kp COLON  &kp BSLH  &trans
                              &trans     &trans    &trans    &trans     &trans    &trans  &trans     &trans    &trans     &trans
            >;
        };
    };
};
